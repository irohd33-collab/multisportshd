{
  "name": "multisportshd-desktop",
  "productName": "MultiSportsHD",
  "version": "1.0.0",
  "description": "MultiSportsHD — Canlı Spor Yayınları Masaüstü Uygulaması",
  "main": "main.js",
  "author": {
    "name": "MultiSportsHD",
    "email": "support@multisportshd.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.multisportshd.desktop",
    "productName": "MultiSportsHD",
    "directories": {
      "output": "../downloads/desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "tray.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MultiSportsHD"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Sports"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png"
    }
  },
  "homepage": "https://multisportshd.com",
  "maintainers": "[\"MultiSportsHD <support@multisportshd.com>\"]"
}